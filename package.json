{
  "name": "boomerang",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @boomerang/web dev",
    "build": "pnpm --filter @boomerang/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:supabase": "pnpm --filter @boomerang/web test:supabase",
    "db:status": "supabase migration list --linked",
    "db:push": "supabase db push --linked"
  },
  "devDependencies": {
    "supabase": "^2.118.0"
  }
}
