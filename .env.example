# Copy to apps/web/.env.local and fill in. Never commit real values.

# Demo mode: shows a "Demo" banner, auto-approves new schools, shows magic links
# and staff invite links on screen instead of emailing them.
DEMO_MODE=true

# Secret used to sign session cookies. At least 32 random characters.
# Generate one with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Comma-separated emails allowed to approve schools at /platform/schools.
PLATFORM_ADMIN_EMAILS=

# Base URL used in join links, QR codes, and magic links.
APP_URL=http://localhost:3000

# Data adapter. "pglite" = local Postgres-in-Node, stored under .data/ (prototype).
# "supabase" = the hosted project (being wired up; see docs/DECISIONS.md).
DATA_ADAPTER=pglite

# Only needed when DATA_ADAPTER=supabase. Find them in the Supabase dashboard
# under Project Settings > API Keys.
# The publishable key (sb_publishable_...) is safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key (sb_secret_...) bypasses RLS. Server-only. Never prefix it with
# NEXT_PUBLIC_, never paste it into chat, never commit it.
SUPABASE_SECRET_KEY=

# Only for `pnpm test:supabase`, which runs the database tests (tests/db) against
# a hosted project instead of PGlite. Best: a separate free Supabase project used
# only for tests. Test rows use a "zz-test-" slug and are deleted afterwards.
# DB URL: dashboard > Connect > "Session pooler" connection string (with password).
SUPABASE_TEST_DB_URL=
SUPABASE_TEST_API_URL=
SUPABASE_TEST_SECRET_KEY=
